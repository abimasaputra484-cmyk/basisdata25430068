        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    PELANGGAN ||--o{ KERANJANG : memiliki\n    PELANGGAN ||--o{ PESANAN : membuat\n    ADMIN ||--o{ PRODUK : mengelola\n    KATEGORI ||--o{ PRODUK : mengelompokkan\n    KERANJANG ||--o{ DETAIL_KERANJANG : berisi\n    PRODUK ||--o{ DETAIL_KERANJANG : dipilih\n    PESANAN ||--|{ DETAIL_PESANAN : memiliki\n    PRODUK ||--o{ DETAIL_PESANAN : dipesan\n    PESANAN ||--o| PEMBAYARAN : memiliki\n    PESANAN ||--o| PENGIRIMAN : dikirim\n\n    PELANGGAN {\n        int id_pelanggan PK\n        string nama_pelanggan\n        string email\n        string no_telepon\n        string alamat\n    }\n\n    ADMIN {\n        int id_admin PK\n        string nama_admin\n        string email\n        string password\n    }\n\n    KATEGORI {\n        int id_kategori PK\n        string nama_kategori\n        string deskripsi\n    }\n\n    PRODUK {\n        int id_produk PK\n        int id_admin FK\n        int id_kategori FK\n        string nama_produk\n        decimal harga\n        int stok\n    }\n\n    KERANJANG {\n        int id_keranjang PK\n        int id_pelanggan FK\n        date tanggal_dibuat\n    }\n\n    DETAIL_KERANJANG {\n        int id_detail_keranjang PK\n        int id_keranjang FK\n        int id_produk FK\n        int jumlah\n    }\n\n    PESANAN {\n        int id_pesanan PK\n        int id_pelanggan FK\n        date tanggal_pesanan\n        decimal total_pesanan\n        string status_pesanan\n    }\n\n    DETAIL_PESANAN {\n        int id_detail_pesanan PK\n        int id_pesanan FK\n        int id_produk FK\n        int jumlah\n        decimal harga_satuan\n    }\n\n    PEMBAYARAN {\n        int id_pembayaran PK\n        int id_pesanan FK\n        date tanggal_pembayaran\n        string metode_pembayaran\n        string status_pembayaran\n    }\n\n    PENGIRIMAN {\n        int id_pengiriman PK\n        int id_pesanan FK\n        string jasa_pengiriman\n        string nomor_resi\n        string status_pengiriman\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="U2LmXJInuQU1fgkpRLKo-1">
